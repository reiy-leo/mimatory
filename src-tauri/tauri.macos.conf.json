{
	"$schema": "https://schema.tauri.app/config/2",
	"app": {
		"windows": [
			{
				"decorations": true,
				"height": 760,
				"hiddenTitle": true,
				"minHeight": 640,
				"minWidth": 960,
				"title": "Mimatory",
				"titleBarStyle": "Overlay",
				"transparent": true,
				"width": 1180,
				"windowEffects": {
					"effects": ["sidebar"],
					"state": "followsWindowActiveState"
				}
			}
		]
	},
	"bundle": {
		"macOS": {
			"files": {
				"Resources/zh-Hans.lproj/InfoPlist.strings": "macos/zh-Hans.lproj/InfoPlist.strings"
			},
			"infoPlist": "macos/Info.plist"
		}
	}
}
