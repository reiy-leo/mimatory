{
	"dependencies": {
		"@tauri-apps/api": "2.12.1",
		"@tauri-apps/plugin-opener": "2.5.3",
		"i18next": "26.3.2",
		"jsqr": "1.4.0",
		"lucide-react": "^0.468.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-i18next": "17.0.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@tauri-apps/cli": "^2.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@types/node": "^22.20.5",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "10.5.2",
		"jsdom": "^25.0.1",
		"postcss": "8.5.15",
		"tailwindcss": "3.4.19",
		"typescript": "^5.6.3",
		"vite": "^6.0.1",
		"vitest": "^2.1.5"
	},
	"name": "passless",
	"private": true,
	"scripts": {
		"build": "npm run build:extension-css && tsc && vite build",
		"build:css": "tailwindcss -c tailwind.config.js -i src/styles.css -o /tmp/passless-app.css",
		"build:extension-css": "tailwindcss -c tailwind.config.js -i browser-extension/popup.tailwind.css -o browser-extension/popup.css --minify",
		"dev": "vite",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"preview": "vite preview",
		"tauri": "tauri",
		"test": "vitest run",
		"test:design": "vitest run src/app/designContract.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"version": "0.1.0"
}
